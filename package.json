{
  "name": "autopilot",
  "version": "0.1.0",
  "type": "module",
  "description": "轻量级多阶段任务编排引擎",
  "engines": {
    "bun": ">=1.1.0"
  },
  "bin": {
    "autopilot": "bin/autopilot.ts"
  },
  "scripts": {
    "dev": "bun run src/cli/index.ts",
    "daemon": "bun run src/daemon/index.ts",
    "tui": "bun run src/cli/index.ts tui",
    "build:web": "cd src/web && bunx vite build --outDir ../../web-dist",
    "dev:web": "cd src/web && bunx vite",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "coverage:rpc": "bun run bin/coverage-matrix.ts",
    "check:migrations": "bun run scripts/check-migrations.ts",
    "check:docs": "bun run scripts/check-docs-translation.ts",
    "check:docs:strict": "bun run scripts/check-docs-translation.ts --strict",
    "smoke-test": "bun run scripts/smoke-test.ts",
    "runner-smoke": "bun run scripts/runner/runner-smoke.ts",
    "runner-e2e-live": "bun run scripts/runner/runner-e2e-live.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/view": "^6.43.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@types/dagre": "^0.7.54",
    "@types/qrcode": "^1.5.6",
    "@uiw/codemirror-themes": "^4.25.10",
    "@uiw/react-codemirror": "^4.25.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "commander": "^13.0.0",
    "dagre": "^0.8.5",
    "fflate": "^0.8.3",
    "ink": "^7.0.0",
    "ink-spinner": "^5.0.0",
    "lucide-react": "^1.8.0",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.14.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5",
    "yaml": "^2.8.0",
    "zod": "^4.0.0"
  },
  "optionalDependencies": {
    "@openai/codex": "latest",
    "@google/gemini-cli-sdk": "latest"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/bun": "latest",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.4.0",
    "vite": "^6.0.0"
  }
}
